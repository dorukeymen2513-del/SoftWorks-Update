class UpdateDialog(QDialog):
    def __init__(self, update_info, parent=None):
        super().__init__(parent)
        self.update_info = update_info
        self.setWindowTitle("Update Details")
        self.resize(450, 300)
        self.setStyleSheet("""
            QDialog {
                background: rgba(20, 32, 48, 0.98);
                color: #ffffff;
                border: 1px solid rgba(255, 255, 255, 0.4);
                border-radius: 10px;
                font-family: 'Segoe UI', sans-serif;
            }
        """)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(20, 20, 20, 20)
        layout.setSpacing(12)

        header = QLabel(f"🚀 New Version: v{update_info.get('version', '2.0')}")
        header.setStyleSheet("font-size: 16px; font-weight: bold; color: #00d2ff; background: transparent;")
        layout.addWidget(header)

        size_label = QLabel(f"Update Size: {update_info.get('size', 'Unknown')}")
        size_label.setStyleSheet("font-size: 12px; color: #cccccc; background: transparent;")
        layout.addWidget(size_label)

        details = QTextEdit()
        details.setReadOnly(True)
        details.setPlainText(update_info.get("changelog", "New update available."))
        details.setStyleSheet("""
            QTextEdit {
                background: rgba(0, 0, 0, 0.4);
                border: 1px solid rgba(255, 255, 255, 0.2);
                border-radius: 6px;
                color: #e0e0e0;
                padding: 8px;
            }
        """)
        layout.addWidget(details)

        btn_layout = QHBoxLayout()
        update_btn = QPushButton("Update")
        update_btn.setStyleSheet("""
            QPushButton {
                background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #00e676, stop:1 #008040);
                color: white; font-weight: bold; padding: 8px 20px; border-radius: 6px; border: 1px solid #70ffaa;
            }
            QPushButton:hover { background: #00ff80; }
        """)
        update_btn.clicked.connect(self.start_download)

        close_btn = QPushButton("✖ Close")
        close_btn.setStyleSheet("""
            QPushButton {
                background: rgba(255, 255, 255, 0.15); color: white;
                font-weight: bold; padding: 8px 16px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.3);
            }
            QPushButton:hover { background: rgba(255, 255, 255, 0.3); }
        """)
        close_btn.clicked.connect(self.reject)

        btn_layout.addWidget(update_btn)
        btn_layout.addWidget(close_btn)
        layout.addLayout(btn_layout)

    def start_download(self):
        download_url = self.update_info.get("download_url")
        target_file = self.update_info.get("target_file", "main.py")
        if download_url:
            try:
                urllib.request.urlretrieve(download_url, target_file)
                QMessageBox.information(self, "Success", "Update downloaded! Please restart the application.")
                self.accept()
            except Exception as e:
                QMessageBox.critical(self, "Error", f"An error occurred during download:\n{e}")


