CURRENT_VERSION = "1.0"
UPDATE_URL = "https://raw.githubusercontent.com/dorukeymen2513-del/SoftWorks-Update/refs/heads/main/updates.json"


class UpdateCheckerThread(QThread):
    update_found = pyqtSignal(dict)

    def run(self):
        try:
            req = urllib.request.Request(UPDATE_URL, headers={'User-Agent': 'Mozilla/5.0'})
            with urllib.request.urlopen(req, timeout=5) as response:
                if response.status == 200:
                    data = json.loads(response.read().decode('utf-8'))
                    if data.get("version", "1.0") > CURRENT_VERSION:
                        self.update_found.emit(data)
        except Exception:
            pass


class DragDropArea(QFrame):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setAcceptDrops(True)
        self.setStyleSheet("""
            QFrame {
                border: 2px dashed rgba(255, 255, 255, 0.6);
                border-radius: 10px;
                background-color: rgba(20, 40, 60, 0.4);
            }
            QFrame:hover {
                background-color: rgba(0, 150, 255, 0.25);
                border-color: #70c0ff;
            }
        """)
        layout = QVBoxLayout(self)
        self.label = QLabel("Drag & Drop Files Here\n(or click browse)")
        self.label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.label.setStyleSheet("color: #ffffff; font-size: 13px; font-weight: bold; border: none; background: transparent;")
        layout.addWidget(self.label)
        self.dropped_files = []

    def dragEnterEvent(self, event):
        if event.mimeData().hasUrls():
            event.acceptProposedAction()

    def dropEvent(self, event):
        for url in event.mimeData().urls():
            file_path = url.toLocalFile()
            if os.path.isfile(file_path):
                self.dropped_files.append(file_path)
        self.label.setText(f"{len(self.dropped_files)} File(s) Added!")


