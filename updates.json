    def show_help(self):
        dialog = HelpDialog(self)
        dialog.exec()

    def start_update_check(self):
        self.checker = UpdateCheckerThread()
        self.checker.update_found.connect(self.on_update_found)
        self.checker.start()

    def on_update_found(self, update_info):
        self.pending_update = update_info
        self.red_dot.show()

    def handle_update_click(self):
        if self.pending_update:
            dialog = UpdateDialog(self.pending_update, self)
            if dialog.exec():
                self.red_dot.hide()
        else:
            msg = QMessageBox(self)
            msg.setWindowTitle("Update Check")
            msg.setText("No pending updates found.")
            msg.setStyleSheet("QMessageBox { background: #1a2432; color: white; } QLabel { color: white; }")
            msg.exec()

    def show_category(self, category):
        for cat, btn in self.nav_buttons.items():
            btn.setProperty("active", "true" if cat == category else "false")
            btn.setStyle(btn.style())

        self.clear_grid()

        files = self.media_data.get(category, [])
        if not files:
            self.left_area.setCurrentWidget(self.empty_view)
            return

        row, col = 0, 0
        for path in files:
            card = self.create_media_card(os.path.basename(path), category, path)
            self.grid_layout.addWidget(card, row, col)
            col += 1
            if col > 3:
                col = 0
                row += 1

        self.left_area.setCurrentWidget(self.scroll_area)

    def create_media_card(self, title, category, path_or_url):
        card = QFrame()
        card.setStyleSheet("""
            QFrame {
                background-color: rgba(15, 30, 48, 0.55);
                border: 1px solid rgba(255, 255, 255, 0.35);
                border-radius: 10px; padding: 10px;
            }
            QFrame:hover { background-color: rgba(0, 150, 255, 0.35); border-color: #00d2ff; }
        """)
        card_layout = QVBoxLayout(card)
        card_layout.setAlignment(Qt.AlignmentFlag.AlignCenter)
        
        img_label = QLabel()
        img_label.setFixedSize(130, 100)
        img_label.setScaledContents(True)

        if category == "Music":
            pixmap = QPixmap(self.icon_name) if os.path.exists(self.icon_name) else QPixmap()
            img_label.setPixmap(pixmap)
        elif category == "Photos":
            img_label.setPixmap(QPixmap(path_or_url))
        else:
            img_label.setText("🎬")
            img_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
            img_label.setStyleSheet("font-size: 38px; background: rgba(0, 0, 0, 0.4); border-radius: 6px; color: #ffffff;")

        name_label = QLabel(title)
        name_label.setMaximumWidth(130)
        name_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        name_label.setStyleSheet("font-size: 11px; color: #ffffff; font-weight: bold; background: transparent;")

        card_layout.addWidget(img_label)
        card_layout.addWidget(name_label)
        card.mousePressEvent = lambda e: self.play_item(path_or_url, category, title)
        return card

    def play_item(self, path_or_url, category, title=""):
        self.title_label.setText(title if title else os.path.basename(path_or_url))

        if category in ["Videos", "Films", "Music"]:
            self.photo_preview.hide()
            self.video_widget.show()
            self.controls_widget.show()
            self.left_area.setCurrentWidget(self.player_container)
            self.player.setSource(QUrl.fromLocalFile(path_or_url))
            self.player.play()
            self.play_btn.setText("Pause")

        elif category == "Photos":
            self.video_widget.hide()
            self.controls_widget.hide()
            pix = QPixmap(path_or_url)
            if not pix.isNull():
                self.photo_preview.setPixmap(pix.scaled(800, 500, Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation))
                self.photo_preview.show()
                self.left_area.setCurrentWidget(self.player_container)

    def toggle_play(self):
        if self.player.playbackState() == QMediaPlayer.PlaybackState.PlayingState:
            self.player.pause()
            self.play_btn.setText("Play")
        else:
            self.player.play()
            self.play_btn.setText("Pause")

    def stop_and_close_player(self):
        self.player.stop()
        self.left_area.setCurrentWidget(self.scroll_area)

    def open_add_dialog(self):
        dialog = AddFileDialog(self)
        if dialog.exec():
            cat = dialog.category_combo.currentText()
            files = dialog.drop_area.dropped_files
            if files:
                self.media_data[cat].extend(files)
                self.save_data()
                self.show_category(cat)

    def clear_grid(self):
        for i in reversed(range(self.grid_layout.count())): 
            widget = self.grid_layout.itemAt(i).widget()
            if widget:
                widget.setParent(None)

    def save_data(self):
        with open(self.data_file, "w", encoding="utf-8") as f:
            json.dump(self.media_data, f, ensure_ascii=False, indent=4)

    def load_data(self):
        if os.path.exists(self.data_file):
            with open(self.data_file, "r", encoding="utf-8") as f:
                loaded = json.load(f)
                for cat in ["Videos", "Films", "Music", "Photos"]:
                    if cat in loaded:
                        self.media_data[cat] = loaded[cat]

if __name__ == "__main__":
    app = QApplication(sys.argv)
    player = SoftWorksMediaPlayer()
    player.show()
    sys.exit(app.exec())
